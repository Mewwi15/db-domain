# Copy to .env.local. Restart the dev server after changes.
# Only use a browser-safe publishable key. Never use a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_SCHEMA=public
# Optional initial table. All public tables are discovered automatically by RPC.
NEXT_PUBLIC_SUPABASE_TABLE=
# Run supabase/setup-db-explorer.sql once in Supabase SQL Editor.
# Login is required by default. RLS must enforce actual database permissions.
NEXT_PUBLIC_REQUIRE_AUTH=true
